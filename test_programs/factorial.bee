fn main() {
    print(factorial(5));
    print(recu_factorial(12));
    return;
}

fn factorial(n: int) : int {
    let factorial = 1;
    let i = 1;
    while(i <= n) {
        factorial = factorial * i;
        i = i + 1;
    }
    return factorial;
}

fn recu_factorial(n : int): int {
    if (n == 1) {
        return 1;
    }
    return n * recu_factorial(n - 1);
}