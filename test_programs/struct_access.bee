struct vector2 {
    x : int;
    y : int;
}

struct String {
    data : [] char;
    length: int;
}

fn vector2_add(a: vector2, b: vector2) : vector2 {
    let result: vector2;
    result.x = a.x + b.x; 
    result.y = a.y + b.y;
    return result;
}

fn scale_vector(v: vector2, scale: int) : vector2 {
    let result: vector2;
    result.x = v.x * scale;
    result.y = v.y * scale;
    return result;
}

fn main (arg_count: int, args: [] String) : int {
    let s = make(String);
    let keys = make(String, 10);
    let values = make(String, 10);
    let a = "10" + "10";
    let b = 67 + 2;
}